<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_library_book_tree" model="ir.ui.view">
        <field name="name">library.book.tree</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list string="Livres">
                <field name="name"/>
                <field name="author"/>
                <field name="author_id"/>
                <field name="isbn"/>
                <field name="publication_date"/>
                <field name="state"/>
                <field name="available"/>
            </list>
        </field>
    </record>

    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Livre">
                <header>
                    <button name="action_borrow" string="Emprunter" type="object" class="btn-primary" invisible="state == 'borrowed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,available,borrowed"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="author"/>
                        <field name="author_id"/>
                        <field name="isbn"/>
                        <field name="publication_date"/>
                        <field name="available"/>
                    </group>
                    <notebook>
                        <page string="Emprunts">
                            <field name="loan_ids">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="borrow_date"/>
                                    <field name="return_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_library_book_search" model="ir.ui.view">
        <field name="name">library.book.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search string="Rechercher des livres">
                <field name="name"/>
                <field name="author_id"/>
                <filter string="Disponible" name="filter_available" domain="[('state', '=', 'available')]"/>
                <filter string="Emprunte" name="filter_borrowed" domain="[('state', '=', 'borrowed')]"/>
                <filter string="Brouillon" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter string="Publication ce mois" name="filter_pub_month" date="publication_date"/>
                <separator/>
                <filter string="Auteur" name="group_by_author" context="{'group_by': 'author_id'}"/>
                <filter string="Etat" name="group_by_state" context="{'group_by': 'state'}"/>
                <filter string="Date de publication" name="group_by_pub_date" context="{'group_by': 'publication_date'}"/>
            </search>
        </field>
    </record>

    <record id="view_library_book_kanban" model="ir.ui.view">
        <field name="name">library.book.kanban</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="state"/>
                <field name="author_id"/>
                <field name="is_overdue"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card #{record.is_overdue.raw_value ? 'oe_kanban_color_danger' : ''}">
                            <div class="o_kanban_record_title">
                                <field name="name"/>
                            </div>
                            <div>
                                <field name="author_id"/>
                            </div>
                            <div>
                                <field name="state"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_library_book" model="ir.actions.act_window">
        <field name="name">Livres</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_library_book_search"/>
    </record>
</odoo>