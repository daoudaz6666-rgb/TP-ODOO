<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_library_book_kanban" model="ir.ui.view">
        <field name="name">library.book.kanban</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="author_id"/>
                <field name="available"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card #{record.available.raw_value ? 'border-success' : 'border-danger'}">
                            <strong><field name="name"/></strong>
                            <div><field name="author_id"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
